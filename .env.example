# PIH 工程环境配置模板（复制为 .env 后填写）
# .env 已 gitignore，勿提交真实密钥

# ---- PostgreSQL（架构 §7 / ADR-005）----
POSTGRES_DB=pih
POSTGRES_USER=pih
POSTGRES_PASSWORD=pih
POSTGRES_PORT=5432

# ---- MinIO（原文快照，架构 §5.3）----
MINIO_ROOT_USER=pih
MINIO_ROOT_PASSWORD=pih12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- LLM API（外部，Sprint 0 spike 已用）----
# 留空则 LLM 相关测试跳过；填则可跑抽取/粗筛集成测试
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
