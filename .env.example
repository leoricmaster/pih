# PIH 工程环境配置模板（复制为 .env 后填写）
# .env 已 gitignore，勿提交真实密钥

# ---- PostgreSQL（架构 §7 / ADR-005）----
POSTGRES_DB=pih
POSTGRES_USER=pih
POSTGRES_PASSWORD=pih
POSTGRES_PORT=5432
# Sprint 3 store 层 + alembic 迁移用 DSN（值由上面三项拼出）
# 用 +psycopg 显式指定 psycopg3 driver（alembic/sqlalchemy 默认走 psycopg2）
PG_DSN=postgresql+psycopg://pih:pih@localhost:5432/pih

# ---- MinIO（原文快照，架构 §5.3）----
MINIO_ROOT_USER=pih
MINIO_ROOT_PASSWORD=pih12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 本地开发 MINIO_ENDPOINT=localhost:9000（浏览器直连可达 presigned URL）；
# docker compose 部署用 minio:9000，presigned URL 浏览器不可达时降级展示 ID 文本
MINIO_ENDPOINT=localhost:9000

# ---- LLM API（外部，OpenAI 兼容端点；命名沿用 Sprint 0 spike 已验证口径）----
# 留空则 LLM 相关测试跳过（pih process 直接报错退出）；填则可跑抽取/粗筛
# large=结构化抽取/核实，small=相关性粗筛（架构 §9.2 分级调用）
PIH_LLM_BASE_URL=
PIH_LLM_API_KEY=
PIH_LLM_LARGE_MODEL=
PIH_LLM_SMALL_MODEL=

# ---- 消费层 Web/API（架构 §4 / ADR-006，Sprint 5a）----
# API 端点鉴权 token（Web 内网默认开放，不鉴权）
PIH_API_TOKEN=
PIH_WEB_HOST=127.0.0.1
PIH_WEB_PORT=8000
